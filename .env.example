# Copy to .env and fill in. Load it with: set -a && . ./.env && set +a

# Required. Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional (defaults match docker-compose.yml for local development)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/focusboard
POSTGRES_USER=focusboard_user
POSTGRES_PASSWORD=focusboard_pass
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ALLOWED_ORIGINS=http://localhost:4200
